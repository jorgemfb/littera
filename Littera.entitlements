<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Recordar entre sesiones el acceso a las carpetas que el usuario autoriza
	     (imágenes locales de los documentos). El resto de permisos del sandbox
	     se generan desde los ajustes de compilación del target. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
